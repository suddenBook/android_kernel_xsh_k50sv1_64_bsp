# Standalone diagnostic replacement for k50sv1_64_bsp_source.fragment.
# Keep it semantically identical to production except for WUSB3801X: the
# Android 10 kernel glue accepts one TARGET_KERNEL_ADDITIONAL_CONFIG file.
CONFIG_FRAME_WARN=1700

CONFIG_CUSTOM_KERNEL_LCM="ft8057s_inx_hdplus1560"
CONFIG_MTK_LCM=y

CONFIG_TOUCHSCREEN_MTK=y
CONFIG_TOUCHSCREEN_MTK_FOCALTECH_FT8057=y
# CONFIG_TOUCHSCREEN_MTK_GT1151 is not set
CONFIG_MTK_GPIO_HALL=y

CONFIG_MTK_PSC5415_SUPPORT=y
CONFIG_MTK_SWITCH_INPUT_OUTPUT_CURRENT_SUPPORT=y
# CONFIG_USB_CC_WUSB3801X is not set
# CONFIG_MTK_BQ25896_SUPPORT is not set

CONFIG_CUSTOM_KERNEL_ACCELEROMETER=y
CONFIG_MTK_MIR3DA=y
# CONFIG_MTK_MPU6515A is not set
# CONFIG_CUSTOM_KERNEL_ALSPS is not set
# CONFIG_CUSTOM_KERNEL_GYROSCOPE is not set
# CONFIG_CUSTOM_KERNEL_MAGNETOMETER is not set

CONFIG_CUSTOM_KERNEL_IMGSENSOR="imx145_mipi_raw gc5025_mipi_raw"
CONFIG_MTK_IMGSENSOR=y
CONFIG_MTK_CAM_CAL=y
CONFIG_CUSTOM_KERNEL_CAM_CAL_DRV="s5k2p8_eeprom ov8858_eeprom"

CONFIG_MTK_LENS=y
# CONFIG_MTK_LENS_DW9761AF_SUPPORT is not set
# CONFIG_MTK_LENS_DUMMYLENS_SUPPORT is not set
# CONFIG_MTK_LENS_AD5820AF_SUPPORT is not set
CONFIG_MTK_LENS_BU6424AF_SUPPORT=y
# CONFIG_MTK_LENS_BU6429AF_SUPPORT is not set
# CONFIG_MTK_LENS_DW9714AF_SUPPORT is not set
# CONFIG_MTK_LENS_LC898212AF_SUPPORT is not set
# CONFIG_MTK_LENS_LC898214AF_SUPPORT is not set

# CONFIG_MTK_NFC is not set
# CONFIG_MTK_FINGERPRINT_SUPPORT is not set
# CONFIG_GATOR is not set
