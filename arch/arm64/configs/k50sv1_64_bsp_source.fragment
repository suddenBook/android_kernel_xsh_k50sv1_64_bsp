# Source-kernel delta over the byte-exact captured stock configuration.
# Runtime-proven fitted hardware, build hygiene and F2FS userdata.
CONFIG_FRAME_WARN=1700

CONFIG_CUSTOM_KERNEL_LCM="ft8057s_inx_hdplus1560"
CONFIG_MTK_LCM=y

CONFIG_TOUCHSCREEN_MTK=y
CONFIG_TOUCHSCREEN_MTK_FOCALTECH_FT8057=y
# CONFIG_TOUCHSCREEN_MTK_GT1151 is not set
CONFIG_MTK_GPIO_HALL=y

CONFIG_MTK_PSC5415_SUPPORT=y
CONFIG_MTK_SWITCH_INPUT_OUTPUT_CURRENT_SUPPORT=y
CONFIG_USB_CC_WUSB3801X=y
CONFIG_MTK_CONNECTIVITY_SOURCE=m
# The inherited internal wireless database contains no regulatory rules.
# CONFIG_CFG80211_INTERNAL_REGDB is not set
# CONFIG_MTK_BQ25896_SUPPORT is not set

CONFIG_CUSTOM_KERNEL_ACCELEROMETER=y
CONFIG_MTK_MIR3DA=y
# CONFIG_MTK_MPU6515A is not set
# CONFIG_CUSTOM_KERNEL_ALSPS is not set
# CONFIG_CUSTOM_KERNEL_GYROSCOPE is not set
# CONFIG_CUSTOM_KERNEL_MAGNETOMETER is not set

# The rear module was removed; keep GC5025 at vendor sensor-table slot 6.
CONFIG_CUSTOM_KERNEL_IMGSENSOR="gc5025_mipi_raw"
CONFIG_MTK_IMGSENSOR=y
CONFIG_MTK_CAM_CAL=y
CONFIG_CUSTOM_KERNEL_CAM_CAL_DRV="s5k2p8_eeprom ov8858_eeprom"

# GC5025 uses the vendor's dummy SUB lens; the removed rear owned BU6424AF.
# CONFIG_MTK_LENS is not set
# CONFIG_MTK_LENS_DW9761AF_SUPPORT is not set
# CONFIG_MTK_LENS_DUMMYLENS_SUPPORT is not set
# CONFIG_MTK_LENS_AD5820AF_SUPPORT is not set
# CONFIG_MTK_LENS_BU6424AF_SUPPORT is not set
# CONFIG_MTK_LENS_BU6429AF_SUPPORT is not set
# CONFIG_MTK_LENS_DW9714AF_SUPPORT is not set
# CONFIG_MTK_LENS_LC898212AF_SUPPORT is not set
# CONFIG_MTK_LENS_LC898214AF_SUPPORT is not set

# CONFIG_MTK_NFC is not set
# CONFIG_MTK_FINGERPRINT_SUPPORT is not set
# CONFIG_GATOR is not set
CONFIG_K50SV1_STOCK_SENSOR_LIST=y

# Owner policy: screen on -> all cores at maximum; normal MT6755 screen off
# -> CPU0 only. PPM overrides ordinary clients with this panel policy;
# power budgets, 5A, calibration and suspend retain their existing limits.
# Panel edges come from mt_ppm_policy_lcm_off.c; no perf daemon is needed.
CONFIG_MTK_PPM_LCMON_BOOST=y

# F2FS is built in for /data and recovery, with SELinux labels (E-185/E-186).
# Keep the existing userdata feature policy: SELinux labels without POSIX ACLs.
# The owner keeps userdata unencrypted, so do not select FS_ENCRYPTION either.
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y
# CONFIG_F2FS_FS_POSIX_ACL is not set
# CONFIG_F2FS_FS_ENCRYPTION is not set
CONFIG_F2FS_STAT_FS=y
# CONFIG_F2FS_CHECK_FS is not set
# CONFIG_F2FS_IO_TRACE is not set
# CONFIG_F2FS_FAULT_INJECTION is not set
