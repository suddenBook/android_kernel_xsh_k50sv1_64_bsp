config TOUCHSCREEN_MTK_FOCALTECH_FT8057
	bool "FocalTech FT8057 touchscreen for k50sv1"
	depends on TOUCHSCREEN_MTK=y && I2C=y && MTK_LCM=y
	select K50_LCM_BIAS
	default n
	help
	  Build the source candidate for the FT8057 controller fitted to the
	  k50sv1_64_bsp.  This driver intentionally omits firmware flashing,
	  factory tests, gestures, proximity and automatic ESD recovery.
